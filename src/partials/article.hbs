<article class="doc">
{{#with page.title}}
{{#if (or (eq @root.page.component.name 'savanna') (eq @root.page.component.name 'cloud'))}}
<div class="page-header">
<h1 class="page">{{{this}}}</h1>
{{> page-actions}}
</div>
{{else}}
<h1 class="page">{{{this}}}</h1>
{{/if}}
{{/with}}
{{{page.contents}}}
{{> pagination}}
</article>
