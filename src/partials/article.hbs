<article class="doc">
{{#with page.title}}
{{#if (is-cloud-theme @root.page)}}
<div class="page-header">
<h1 class="page">{{{this}}}</h1>
{{> page-actions}}
</div>
{{else if (has-page-actions @root.page)}}
<div class="page-header page-header--actions">
<h1 class="page">{{{this}}}</h1>
{{> page-actions}}
</div>
{{else}}
<h1 class="page">{{{this}}}</h1>
{{/if}}
{{/with}}
{{{page.contents}}}
{{> pagination}}
</article>
