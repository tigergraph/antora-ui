{{#if page.canonicalUrl}}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "TechArticle",
          "headline": {{{json (detag page.title)}}},
          "description": {{{json (or page.description 'TigerGraph product documentation.')}}},
          "url": {{{json page.canonicalUrl}}},
          "mainEntityOfPage": {{{json page.canonicalUrl}}},
          "inLanguage": "en",
          "isPartOf": {
            "@type": "WebSite",
            "name": "TigerGraph Documentation",
            "url": "https://www.tigergraph.com/docs/"
          },
          "author": {
            "@type": "Organization",
            "name": "TigerGraph",
            "url": "https://www.tigergraph.com/"
          },
          "publisher": {
            "@type": "Organization",
            "name": "TigerGraph",
            "url": "https://www.tigergraph.com/",
            "logo": {
              "@type": "ImageObject",
              "url": "https://www.tigergraph.com/wp-content/uploads/2021/09/TigerGraph-Logo.svg"
            }
          }{{#if page.component.title}},
          "about": {{{json (detag page.component.title)}}}{{/if}}
    }{{#if page.breadcrumbs}},
        {
          "@type": "BreadcrumbList",
          "itemListElement": [
    {{#each page.breadcrumbs}}{
              "@type": "ListItem",
              "position": {{increment @index}},
              "name": {{{json (detag this.content)}}}{{#if this.url}},
              "item": "{{@root.site.url}}{{this.url}}"{{/if}}
      }{{#unless @last}},{{/unless}}
    {{/each}}
    ]
  }{{/if}}
    ]
  }
  </script>
{{/if}}
