<nav class="breadcrumbs" aria-label="breadcrumbs">
  {{#if page.breadcrumbs}}
  <ul>
    {{#with page.componentVersion}}
    {{#if (and ./title (ne ./title @root.page.breadcrumbs.0.content))}}
    {{! the cloud components are unversioned and label themselves "default", which reads as a version to anyone else }}
    <li><a href="{{{relativize ./url}}}">{{{./title}}}{{#unless (and (is-cloud-theme @root.page) (eq ./displayVersion 'default'))}} {{{./displayVersion}}}{{/unless}}</a></li>
    {{/if}}
    {{/with}}
    {{#each page.breadcrumbs}}
    <li>
    {{~#if (and ./url (eq ./urlType 'internal'))~}}
    <a href="{{{relativize ./url}}}">{{{./content}}}</a>
    {{~else~}}
    {{{./content}}}
    {{~/if~}}
    </li>
    {{/each}}
  </ul>
  {{/if}}
</nav>
